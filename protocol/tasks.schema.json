{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/wu8685/Ariel/protocol/tasks.schema.json",
  "oneOf":[{"$ref":"#/$defs/request"},{"$ref":"#/$defs/frame"},{"$ref":"#/$defs/capabilityUpdate"}],
  "$defs":{
    "id":{"type":"string","minLength":1,"maxLength":128},
    "text":{"type":"string","minLength":1,"maxLength":16384},
    "request":{
      "type":"object","additionalProperties":false,"required":["type","v","requestId","deviceId","method","params"],
      "properties":{
        "type":{"const":"request"},"v":{"const":1},"requestId":{"$ref":"v1.schema.json#/$defs/requestId"},"deviceId":{"$ref":"#/$defs/id"},
        "method":{"enum":["task.list","task.read","task.create","task.action","task.feedback","task.readAck"]},
        "params":{"$ref":"#/$defs/params"}
      },
      "allOf":[
        {"if":{"properties":{"method":{"const":"task.create"}}},"then":{"properties":{"params":{"type":"object","required":["clientSubmissionId","title","goal"]}}}},
        {"if":{"properties":{"method":{"enum":["task.read","task.action","task.feedback","task.readAck"]}}},"then":{"properties":{"params":{"type":"object","required":["taskId"]}}}},
        {"if":{"properties":{"method":{"enum":["task.action","task.feedback"]}}},"then":{"properties":{"params":{"type":"object","required":["clientSubmissionId","expectedVersion"]}}}},
        {"if":{"properties":{"method":{"const":"task.action"}}},"then":{"properties":{"params":{"type":"object","required":["action"]}}}},
        {"if":{"properties":{"method":{"const":"task.feedback"}}},"then":{"properties":{"params":{"type":"object","required":["body"]}}}},
        {"if":{"properties":{"method":{"const":"task.readAck"}}},"then":{"properties":{"params":{"type":"object","required":["readSeq"]}}}}
      ]
    },
    "params":{
      "type":"object","additionalProperties":false,"required":["taskStoreId"],
      "properties":{
        "taskStoreId":{"$ref":"#/$defs/id"},"taskId":{"$ref":"#/$defs/id"},"clientSubmissionId":{"$ref":"#/$defs/id"},
        "limit":{"type":"integer","minimum":1,"maximum":100},"cursor":{"type":"string","maxLength":512},
        "title":{"type":"string","minLength":1,"maxLength":200},"goal":{"$ref":"#/$defs/text"},
        "constraints":{"oneOf":[{"type":"string","maxLength":16384},{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/text"}}]},
        "acceptanceCriteria":{"oneOf":[{"type":"string","maxLength":16384},{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/text"}}]},
        "executionHostId":{"type":"string","maxLength":128},"cwd":{"type":"string","maxLength":4096},
        "expectedVersion":{"type":"integer","minimum":1},"action":{"enum":["start","pause","resume","accept","reopen"]},
        "body":{"$ref":"#/$defs/text"},"readSeq":{"type":"integer","minimum":0}
      }
    },
    "command":{
      "type":"object","additionalProperties":false,
      "required":["commandId","taskId","attemptId","executionHostId","bindingGeneration","taskVersion","kind","clientMessageId","text","leaseToken"],
      "properties":{
        "taskStoreId":{"$ref":"#/$defs/id"},"commandId":{"$ref":"#/$defs/id"},"taskId":{"$ref":"#/$defs/id"},"attemptId":{"$ref":"#/$defs/id"},
        "executionHostId":{"$ref":"#/$defs/id"},"bindingGeneration":{"type":"integer","minimum":1},"taskVersion":{"type":"integer","minimum":1},
        "kind":{"enum":["start","feedback","check","claim","work"]},"taskRevision":{"type":"string","pattern":"^[a-f0-9]{64}$"},"nativeThreadId":{"type":"string","maxLength":128},"clientMessageId":{"$ref":"#/$defs/id"},
        "text":{"type":"string","minLength":1,"maxLength":49152},"leaseToken":{"$ref":"#/$defs/id"},"cwd":{"type":"string","maxLength":4096},
        "nativeTurnId":{"$ref":"#/$defs/id"},"state":{"enum":["pending","leased","accepted","unknown","finished"]},
        "sourceSeq":{"type":"integer","minimum":0},"feedbackIds":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/id"}}
      },
      "allOf":[{"if":{"properties":{"kind":{"enum":["claim","work"]}}},"then":{"required":["taskRevision"]}}]
    },
    "receipt":{
      "type":"object","additionalProperties":false,"required":["commandId","leaseToken","outcome"],
      "properties":{
        "commandId":{"$ref":"#/$defs/id"},"leaseToken":{"$ref":"#/$defs/id"},"outcome":{"enum":["accepted","busy","unknown","failed"]},
        "nativeThreadId":{"type":"string","maxLength":128},"nativeTurnId":{"type":"string","maxLength":128},"clientMessageId":{"type":"string","maxLength":128},"reason":{"type":"string","maxLength":128}
      }
    },
    "fact":{
      "type":"object","additionalProperties":false,"required":["eventId","commandId","taskId","attemptId","executionHostId","bindingGeneration","nativeThreadId","nativeTurnId","status"],
      "properties":{
        "eventId":{"$ref":"#/$defs/id"},"commandId":{"$ref":"#/$defs/id"},"taskId":{"$ref":"#/$defs/id"},"attemptId":{"$ref":"#/$defs/id"},
        "executionHostId":{"$ref":"#/$defs/id"},"bindingGeneration":{"type":"integer","minimum":1},"nativeThreadId":{"$ref":"#/$defs/id"},"nativeTurnId":{"$ref":"#/$defs/id"},
        "status":{"enum":["running","completed","failed","waiting"]},"progress":{"type":"string","maxLength":2048},"taskAction":{"enum":["claim","done","blocked"]},"taskRevision":{"type":"string","pattern":"^[a-f0-9]{64}$"},"sourceSeq":{"type":"integer","minimum":0},"feedbackIds":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/id"}}
      },
      "dependentRequired":{"taskAction":["taskRevision"]}
    },
    "capabilityUpdate":{
      "type":"object","additionalProperties":false,"required":["type","v","managementReady","executionReady"],
      "properties":{"type":{"const":"task.capabilities"},"v":{"const":1},"taskStoreId":{"$ref":"#/$defs/id"},"managementReady":{"type":"boolean"},"executionReady":{"type":"boolean"}}
    },
    "frame":{
      "type":"object","additionalProperties":false,"required":["type","v","dispatchId","managementDeviceId","taskStoreId","executionHostId"],
      "properties":{
        "type":{"enum":["task.dispatch","task.track","task.validate","task.validated","task.receipt","task.fact"]},"v":{"const":1},
        "dispatchId":{"$ref":"#/$defs/id"},"managementDeviceId":{"$ref":"#/$defs/id"},"taskStoreId":{"$ref":"#/$defs/id"},"executionHostId":{"$ref":"#/$defs/id"},
        "command":{"$ref":"#/$defs/command"},"valid":{"type":"boolean"},"receipt":{"$ref":"#/$defs/receipt"},"fact":{"$ref":"#/$defs/fact"}
      },
      "allOf":[
        {"if":{"properties":{"type":{"enum":["task.dispatch","task.track"]}}},"then":{"required":["command"]}},
        {"if":{"properties":{"type":{"const":"task.validated"}}},"then":{"required":["valid"]}},
        {"if":{"properties":{"type":{"const":"task.receipt"}}},"then":{"required":["receipt"]}},
        {"if":{"properties":{"type":{"const":"task.fact"}}},"then":{"required":["fact"]}}
      ]
    }
  }
}
