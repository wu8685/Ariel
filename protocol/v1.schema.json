{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wu8685/Ariel/protocol/v1.schema.json",
  "title": "Ariel protocol v1 envelope",
  "oneOf": [
    { "$ref": "#/$defs/webHello" },
    { "$ref": "#/$defs/agentHello" },
    { "$ref": "#/$defs/helloOK" },
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/deviceStatus" },
    { "$ref": "#/$defs/threadSnapshot" },
    { "$ref": "#/$defs/threadUpdate" },
    { "$ref": "#/$defs/threadError" },
    { "$ref": "#/$defs/threadCacheSnapshot" },
    { "$ref": "#/$defs/threadCacheUpdate" },
    { "$ref": "#/$defs/threadCacheStatus" },
    { "$ref": "#/$defs/threadCacheRemove" },
    { "$ref": "#/$defs/interactionResolved" },
    { "$ref": "#/$defs/authPairConsumed" },
    { "$ref": "tasks.schema.json" },
    { "$ref": "settings.schema.json" },
    { "$ref": "edit.schema.json" }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "requestId": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["autoLoad", "codexReady"],
      "properties": {
        "autoLoad": { "type": "boolean" },
        "codexReady": { "type": "boolean" },
        "executionSettings": { "type": "boolean" },
        "turnEditing": { "type": "boolean" },
        "history": { "type": "boolean" },
        "send": { "type": "boolean" },
        "interrupt": { "type": "boolean" },
        "interaction": { "type": "boolean" },
        "queue": { "type": "boolean" },
        "threadCreate": { "type": "boolean" },
        "threadBootstrap": { "type": "boolean" },
        "threadArchive": { "type": "boolean" },
        "threadArchiveUndo": { "type": "boolean" },
        "threadRename": { "type": "boolean" },
        "threadPin": { "type": "boolean" },
        "chillingFileContext": { "type": "boolean" },
        "chillingMessageReferences": { "type": "boolean" },
        "chillingWorkspaceBrowser": { "type": "boolean" },
        "taskManagement": { "type": "boolean" },
        "taskExecution": { "type": "boolean" },
        "taskExecutionAuthorized": { "type": "boolean" },
        "taskTracking": { "type": "boolean" }
      }
    },
    "webHello": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "v", "role", "token"],
      "properties": {
        "type": { "const": "hello" }, "v": { "const": 1 }, "role": { "const": "web" },
        "token": { "type": "string", "minLength": 1 }
      }
    },
    "agentHello": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "v", "role", "token", "deviceId", "deviceName", "agentEpoch", "adapterVersion", "capabilities"],
      "properties": {
        "type": { "const": "hello" }, "v": { "const": 1 }, "role": { "const": "agent" },
        "token": { "type": "string", "minLength": 1 },
        "deviceId": { "$ref": "#/$defs/id" }, "deviceName": { "$ref": "#/$defs/id" },
        "agentEpoch": { "$ref": "#/$defs/id" }, "adapterVersion": { "$ref": "#/$defs/id" },
        "taskStoreId": { "$ref": "#/$defs/id" },
        "capabilities": { "$ref": "#/$defs/capabilities" }
      }
    },
    "helloOK": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "v", "connectionId", "relayEpoch"],
      "properties": {
        "type": { "const": "hello.ok" }, "v": { "const": 1 },
        "connectionId": { "$ref": "#/$defs/id" }, "relayEpoch": { "$ref": "#/$defs/id" },
        "sessionToken": { "type": "string", "pattern": "^s_[0-9a-f]{64}$" }
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "v", "requestId", "deviceId", "method", "params"],
      "properties": {
        "type": { "const": "request" }, "v": { "const": 1 },
        "requestId": { "$ref": "#/$defs/requestId" }, "deviceId": { "$ref": "#/$defs/id" },
        "method": { "enum": ["auth.pair.create", "auth.pair.cancel", "device.list", "thread.create", "thread.bootstrap", "thread.archive.update", "thread.archive.undo", "thread.name.update", "thread.pin.update", "thread.list", "thread.read", "thread.history", "thread.history.items", "thread.image", "thread.activity.read", "thread.subscribe", "thread.unsubscribe", "thread.cache.read", "thread.cache.watch", "thread.cache.unwatch", "thread.cache.promote", "thread.cache.touch", "file.context.asset.read", "file.context.changes", "file.context.read", "file.context.reference.read", "workspace.files.list", "workspace.file.read", "turn.start", "turn.interrupt", "queue.add", "queue.update", "queue.delete", "queue.reorder", "queue.steer", "interaction.respond", "thread.questions.respond"] },
        "params": { "type": "object" }
      },
      "allOf": [
        { "if": { "properties": { "method": { "const": "auth.pair.create" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/emptyParams" } } } },
        { "if": { "properties": { "method": { "const": "auth.pair.cancel" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/pairCancelParams" } } } },
        { "if": { "properties": { "method": { "const": "device.list" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/emptyParams" } } } },
        { "if": { "properties": { "method": { "const": "thread.create" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/createThreadParams" } } } },
        { "if": { "properties": { "method": { "const": "thread.bootstrap" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/bootstrapThreadParams" } } } },
        { "if": { "properties": { "method": { "const": "thread.archive.update" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/archiveThreadParams" } } } },
        { "if": { "properties": { "method": { "const": "thread.archive.undo" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/archiveUndoParams" } } } },
        { "if": { "properties": { "method": { "const": "thread.name.update" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/renameThreadParams" } } } },
        { "if": { "properties": { "method": { "const": "thread.pin.update" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/pinThreadParams" } } } },
        { "if": { "properties": { "method": { "const": "thread.list" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/listParams" } } } },
        { "if": { "properties": { "method": { "const": "thread.read" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/threadParams" } } } },
        { "if": { "properties": { "method": { "const": "thread.history" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/historyParams" } } } },
        { "if": { "properties": { "method": { "const": "thread.history.items" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/historyItemsParams" } } } },
        { "if": { "properties": { "method": { "const": "thread.image" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/imageParams" } } } },
        { "if": { "properties": { "method": { "const": "thread.activity.read" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/activityParams" } } } },
        { "if": { "properties": { "method": { "const": "thread.subscribe" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/subscribeParams" } } } },
        { "if": { "properties": { "method": { "const": "thread.unsubscribe" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/unsubscribeParams" } } } },
        { "if": { "properties": { "method": { "enum": ["thread.cache.read", "thread.cache.watch", "thread.cache.promote"] } } }, "then": { "properties": { "params": { "$ref": "#/$defs/threadParams" } } } },
        { "if": { "properties": { "method": { "const": "thread.cache.touch" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/cacheTouchParams" } } } },
        { "if": { "properties": { "method": { "const": "thread.cache.unwatch" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/cacheUnwatchParams" } } } },
        { "if": { "properties": { "method": { "const": "file.context.asset.read" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/documentAssetParams" } } } },
        { "if": { "properties": { "method": { "const": "file.context.changes" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/fileContextChangesParams" } } } },
        { "if": { "properties": { "method": { "const": "file.context.read" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/fileContextReadParams" } } } },
        { "if": { "properties": { "method": { "const": "file.context.reference.read" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/fileContextReferenceReadParams" } } } },
        { "if": { "properties": { "method": { "const": "workspace.files.list" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/workspaceFilesListParams" } } } },
        { "if": { "properties": { "method": { "const": "workspace.file.read" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/workspaceFileReadParams" } } } },
        { "if": { "properties": { "method": { "const": "turn.start" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/startParams" } } } },
        { "if": { "properties": { "method": { "const": "turn.interrupt" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/interruptParams" } } } },
        { "if": { "properties": { "method": { "const": "queue.add" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/queueAddParams" } } } },
        { "if": { "properties": { "method": { "const": "queue.update" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/queueUpdateParams" } } } },
        { "if": { "properties": { "method": { "const": "queue.delete" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/queueItemParams" } } } },
        { "if": { "properties": { "method": { "const": "queue.reorder" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/queueReorderParams" } } } },
        { "if": { "properties": { "method": { "const": "queue.steer" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/queueSteerParams" } } } },
        { "if": { "properties": { "method": { "const": "interaction.respond" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/respondParams" } } } },
        { "if": { "properties": { "method": { "const": "thread.questions.respond" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/questionAnswerParams" } } } }
      ]
    },
    "emptyParams": { "type": "object", "additionalProperties": false },
    "pairCancelParams": {
      "type": "object", "additionalProperties": false, "required": ["credential"],
      "properties": { "credential": { "type": "string", "pattern": "^p_[0-9a-f]{64}$" } }
    },
    "listParams": {
      "type": "object", "additionalProperties": false,
      "properties": { "cursor": { "type": ["string", "null"] }, "limit": { "type": "integer", "minimum": 1, "maximum": 100 }, "searchTerm": { "type": "string", "minLength": 1, "maxLength": 128 } }
    },
    "createThreadParams": {
      "type": "object", "additionalProperties": false, "required": ["cwd"],
      "properties": { "cwd": { "type": "string", "minLength": 1, "maxLength": 4096 } }
    },
    "bootstrapThreadParams": {
      "type": "object", "additionalProperties": false, "required": ["cwd", "clientMessageId", "text"],
      "anyOf": [{ "properties": { "text": { "type": "string", "minLength": 1 } } }, { "required": ["images"], "properties": { "images": { "type": "array", "minItems": 1 } } }],
      "properties": {
        "settings": {"$ref":"settings.schema.json#/$defs/values"},
        "cwd": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/" },
        "clientMessageId": { "$ref": "#/$defs/requestId" },
        "text": { "type": "string", "maxLength": 65536 },
        "images": { "type": "array", "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 5592435 } }
      }
    },
    "archiveThreadParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId", "archived"],
      "properties": { "threadId": { "$ref": "#/$defs/id" }, "archived": { "const": true } }
    },
    "archiveUndoParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId", "operationId"],
      "properties": { "threadId": { "$ref": "#/$defs/id" }, "operationId": { "$ref": "#/$defs/id" } }
    },
    "renameThreadParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId", "name"],
      "properties": {
        "threadId": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\x00-\\x1F\\x7F-\\x9F]*\\S[^\\x00-\\x1F\\x7F-\\x9F]*$" }
      }
    },
    "pinThreadParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId", "pinned"],
      "properties": { "threadId": { "$ref": "#/$defs/id" }, "pinned": { "type": "boolean" } }
    },
    "threadParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId"],
      "properties": { "threadId": { "$ref": "#/$defs/id" }, "asyncQuestionsVersion": {"const": 1} }
    },
    "subscribeParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId"],
      "properties": {
        "threadId": { "$ref": "#/$defs/id" },
        "updateMode": { "enum": ["item-delta-v1"] }
      }
    },
    "historyParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId"],
      "properties": { "threadId": { "$ref": "#/$defs/id" }, "asyncQuestionsVersion": {"const": 1}, "cursor": { "type": ["string", "null"] }, "limit": { "type": "integer", "minimum": 1, "maximum": 10 } }
    },
    "historyItemsParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId", "turnId"],
      "properties": { "threadId": { "$ref": "#/$defs/id" }, "turnId": { "$ref": "#/$defs/id" }, "asyncQuestionsVersion": {"const": 1}, "cursor": { "type": ["string", "null"] }, "limit": { "type": "integer", "minimum": 1, "maximum": 100 } }
    },
    "imageParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId", "turnId", "itemId", "imageIndex"],
      "properties": { "threadId": { "$ref": "#/$defs/id" }, "turnId": { "$ref": "#/$defs/id" }, "itemId": { "$ref": "#/$defs/id" }, "imageIndex": { "type": "integer", "minimum": 0, "maximum": 23 } }
    },
    "activityParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId", "turnId", "itemId"],
      "properties": {
        "threadId": { "$ref": "#/$defs/id" }, "turnId": { "$ref": "#/$defs/id" }, "itemId": { "$ref": "#/$defs/id" },
        "cursor": { "type": ["string", "null"], "pattern": "^[0-9]+$" },
        "limitBytes": { "type": "integer", "minimum": 1, "maximum": 262144 },
        "expectedRevision": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "unsubscribeParams": {
      "type": "object", "additionalProperties": false, "required": ["subscriptionId"],
      "properties": { "subscriptionId": { "$ref": "#/$defs/id" } }
    },
    "cacheUnwatchParams": {
      "type": "object", "additionalProperties": false, "required": ["watchId"],
      "properties": { "watchId": { "$ref": "#/$defs/id" } }
    },
    "cacheTouchParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId"],
      "properties": { "threadId": { "$ref": "#/$defs/id" }, "watching": { "type": "boolean" }, "asyncQuestionsVersion": {"const":1} }
    },
    "questionAnswerParams": {
      "type":"object","additionalProperties":false,"required":["threadId","agentEpoch","turnId","questionId","fingerprint","operationId","answer"],
      "properties":{"threadId":{"$ref":"#/$defs/id"},"agentEpoch":{"$ref":"#/$defs/id"},"turnId":{"$ref":"#/$defs/id"},"questionId":{"$ref":"#/$defs/id"},"fingerprint":{"type":"string","minLength":1,"maxLength":128},"operationId":{"$ref":"#/$defs/id"},"answer":{"type":"string","minLength":1,"maxLength":8192}}
    },
    "relativeFilePath": {
      "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^/\\\\].*$",
      "not": { "pattern": "(^|/)\\.\\.(/|$)|\\\\" }
    },
    "workspaceDirectoryPath": {
      "type": "string", "maxLength": 4096, "pattern": "^[^/\\\\].*$|^$",
      "not": { "pattern": "(^|/)\\.\\.(/|$)|\\\\" }
    },
    "documentAssetParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "threadId",
        "agentEpoch",
        "documentSha256",
        "imageReference"
      ],
      "properties": {
        "source": {
          "enum": [
            "turn_change",
            "message_reference",
            "workspace_browser"
          ]
        },
        "threadId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "agentEpoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "turnId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "itemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "path": {
          "$ref": "#/$defs/relativeFilePath"
        },
        "referenceKind": {
          "enum": [
            "markdown_link",
            "plain_path"
          ]
        },
        "rawReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "documentSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "imageReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "cursor": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16,128}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "workspace_browser"
              }
            }
          },
          "then": {
            "required": [
              "path"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "turnId"
                  ]
                },
                {
                  "required": [
                    "itemId"
                  ]
                },
                {
                  "required": [
                    "rawReference"
                  ]
                },
                {
                  "required": [
                    "referenceKind"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "turn_change"
              }
            }
          },
          "then": {
            "required": [
              "path",
              "turnId",
              "itemId"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "rawReference"
                  ]
                },
                {
                  "required": [
                    "referenceKind"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "message_reference"
              }
            }
          },
          "then": {
            "required": [
              "turnId",
              "itemId",
              "referenceKind",
              "rawReference"
            ]
          }
        }
      ]
    },
    "fileContextChangesParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId", "turnIds"],
      "properties": { "threadId": { "$ref": "#/$defs/id" }, "turnIds": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } }
    },
    "fileContextReadParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId", "turnId", "itemId", "path"],
      "properties": { "threadId": { "$ref": "#/$defs/id" }, "turnId": { "$ref": "#/$defs/id" }, "itemId": { "$ref": "#/$defs/id" }, "path": { "$ref": "#/$defs/relativeFilePath" } }
    },
    "fileContextReferenceReadParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId", "turnId", "itemId", "referenceKind", "rawReference"],
      "properties": {
        "threadId": { "$ref": "#/$defs/id" }, "turnId": { "$ref": "#/$defs/id" }, "itemId": { "$ref": "#/$defs/id" },
        "referenceKind": { "enum": ["markdown_link", "plain_path"] },
        "rawReference": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\x00-\\x1F\\x7F-\\x9F]+$" },
        "startLine": { "type": "integer", "minimum": 1 }, "endLine": { "type": "integer", "minimum": 1 }
      }
    },
    "workspaceFilesListParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId", "path"],
      "properties": { "threadId": { "$ref": "#/$defs/id" }, "path": { "$ref": "#/$defs/workspaceDirectoryPath" }, "cursor": { "type": "string", "minLength": 1, "maxLength": 8192 }, "limit": { "type": "integer", "minimum": 1, "maximum": 200 } }
    },
    "workspaceFileReadParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId", "path"],
      "properties": { "threadId": { "$ref": "#/$defs/id" }, "path": { "$ref": "#/$defs/relativeFilePath" } }
    },
    "fileContextSelection": {
      "type": "object", "additionalProperties": false, "required": ["threadId", "path", "sha256", "modifiedAtMs", "startLine", "endLine", "text"],
      "properties": {
        "source": { "enum": ["turn_change", "message_reference", "workspace_browser"] },
        "threadId": { "$ref": "#/$defs/id" }, "turnId": { "$ref": "#/$defs/id" }, "itemId": { "$ref": "#/$defs/id" }, "path": { "$ref": "#/$defs/relativeFilePath" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "modifiedAtMs": { "type": "integer", "minimum": 0 },
        "startLine": { "type": "integer", "minimum": 1 }, "endLine": { "type": "integer", "minimum": 1 }, "text": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "referenceKind": { "enum": ["markdown_link", "plain_path"] },
        "rawReference": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\x00-\\x1F\\x7F-\\x9F]+$" }
      },
      "allOf": [
        { "if": { "required": ["source"], "properties": { "source": { "const": "workspace_browser" } } }, "then": { "not": { "anyOf": [{ "required": ["turnId"] }, { "required": ["itemId"] }, { "required": ["referenceKind"] }, { "required": ["rawReference"] }] } }, "else": { "required": ["turnId", "itemId"] } }
      ]
    },
    "startParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId", "clientMessageId", "text"],
      "anyOf": [{ "properties": { "text": { "type": "string", "minLength": 1 } } }, { "required": ["images"], "properties": { "images": { "type": "array", "minItems": 1 } } }],
      "properties": {
        "threadId": { "$ref": "#/$defs/id" }, "clientMessageId": { "$ref": "#/$defs/requestId" },
        "text": { "type": "string", "maxLength": 65536 },
        "images": { "type": "array", "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 5592435 } },
        "fileContexts": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/fileContextSelection" } }
      }
    },
    "interruptParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId", "expectedTurnId"],
      "properties": { "threadId": { "$ref": "#/$defs/id" }, "expectedTurnId": { "$ref": "#/$defs/id" } }
    },
    "queueAddParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId", "clientMessageId", "text"],
      "anyOf": [{ "properties": { "text": { "type": "string", "minLength": 1 } } }, { "required": ["images"], "properties": { "images": { "type": "array", "minItems": 1 } } }],
      "properties": {
        "threadId": { "$ref": "#/$defs/id" }, "clientMessageId": { "$ref": "#/$defs/requestId" },
        "text": { "type": "string", "maxLength": 65536 },
        "images": { "type": "array", "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 5592435 } },
        "fileContexts": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/fileContextSelection" } }
      }
    },
    "queueUpdateParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId", "queueId", "text"],
      "anyOf": [{ "properties": { "text": { "type": "string", "minLength": 1 } } }, { "required": ["images"], "properties": { "images": { "type": "array", "minItems": 1 } } }],
      "properties": {
        "threadId": { "$ref": "#/$defs/id" }, "queueId": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "maxLength": 65536 },
        "images": { "type": "array", "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 5592435 } }
      }
    },
    "queueItemParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId", "queueId"],
      "properties": { "threadId": { "$ref": "#/$defs/id" }, "queueId": { "$ref": "#/$defs/id" } }
    },
    "queueReorderParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId", "queueIds"],
      "properties": { "threadId": { "$ref": "#/$defs/id" }, "queueIds": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } }
    },
    "queueSteerParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId", "queueId", "expectedTurnId"],
      "properties": { "threadId": { "$ref": "#/$defs/id" }, "queueId": { "$ref": "#/$defs/id" }, "expectedTurnId": { "$ref": "#/$defs/id" } }
    },
    "respondParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId", "interactionId", "decision"],
      "properties": {
        "threadId": { "$ref": "#/$defs/id" }, "interactionId": { "$ref": "#/$defs/id" },
        "decision": { "enum": ["deny", "deny_and_stop", "accept_once", "answer"] },
        "answers": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" }, "minItems": 1 } }
      }
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "v", "requestId", "outcome"],
      "properties": {
        "type": { "const": "response" }, "v": { "const": 1 },
        "requestId": { "$ref": "#/$defs/requestId" },
        "outcome": { "enum": ["accepted", "rejected", "unknown", "not_submitted"] },
        "data": { "type": "object" },
        "error": { "$ref": "#/$defs/error" }
      },
      "allOf": [
        { "if": { "properties": { "outcome": { "const": "accepted" } } }, "then": { "required": ["data"], "not": { "required": ["error"] } } },
        { "if": { "properties": { "outcome": { "enum": ["rejected", "unknown", "not_submitted"] } } }, "then": { "required": ["error"] } }
      ]
    },
    "error": {
      "type": "object", "additionalProperties": false, "required": ["code", "message"],
      "properties": {
        "code": { "enum": ["UNAUTHORIZED", "PROTOCOL_UNSUPPORTED", "DEVICE_OFFLINE", "TURN_BUSY", "STALE_TURN", "STALE_INTERACTION", "INTERACTION_UNSUPPORTED", "OUTCOME_UNKNOWN", "RESYNC_REQUIRED", "NATIVE_STATE_UNCERTAIN", "HISTORY_TOO_LARGE", "INVALID_ARGUMENT", "OVERLOADED", "DUPLICATE_AGENT", "NOT_FOUND", "TIMEOUT", "FEATURE_DISABLED", "CHILLING_UNAVAILABLE", "CONTRACT_UNSUPPORTED", "FILE_NOT_FOUND", "PATH_NOT_ALLOWED", "REFERENCE_NOT_FOUND", "DIRECTORY_CHANGED", "DETAIL_PENDING", "DETAIL_CHANGED", "DETAIL_TOO_LARGE", "UNSUPPORTED_FILE_TYPE", "FILE_TOO_LARGE", "FILE_CHANGED", "TASK_FEEDBACK_IDENTITY_MISMATCH", "TASK_IDEMPOTENCY_CONFLICT", "TASK_INVALID_ARGUMENT", "TASK_INVALID_STATE", "TASK_METHOD_NOT_ALLOWED", "TASK_NATIVE_IDENTITY_REQUIRED", "TASK_NOT_FOUND", "TASK_NOT_READY", "TASK_RECONCILIATION_REQUIRED", "TASK_RESOURCE_LIMIT", "TASK_STALE_BINDING", "TASK_STALE_LEASE", "TASK_STORE_NOT_FOUND", "TASK_UNAUTHORIZED", "TASK_VERSION_CONFLICT"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "thread": {
      "type": "object", "additionalProperties": false,
      "required": ["threadId", "title", "cwd", "updatedAt", "runtime", "turns", "pendingInteractions"],
      "properties": {
        "threadId": { "$ref": "#/$defs/id" }, "title": { "type": "string" }, "searchSnippet": { "type": "string", "maxLength": 400 },
        "cwd": { "type": "string" }, "updatedAt": { "type": "string" },
        "isPinned": { "type": "boolean" },
        "runtime": { "enum": ["idle", "inProgress", "notLoaded", "unknown"] },
        "historyComplete": { "type": "boolean" },
        "recentComplete": { "type": "boolean" },
        "permissions": { "type": "object", "additionalProperties": false, "required": ["sandbox", "approval"], "properties": { "sandbox": { "enum": ["read_only", "workspace_write", "full_access", "unknown"] }, "approval": { "enum": ["on_request", "never", "unknown"] } } },
        "turns": { "type": "array", "items": { "$ref": "#/$defs/turn" } },
        "pendingInteractions": { "type": "array", "items": { "$ref": "#/$defs/interaction" } },
        "queuedMessages": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/queuedMessage" } }
      }
    },
    "threadState": {
      "type": "object", "additionalProperties": false,
      "required": ["threadId", "title", "cwd", "updatedAt", "runtime", "pendingInteractions"],
      "properties": {
        "threadId": { "$ref": "#/$defs/id" }, "title": { "type": "string" }, "searchSnippet": { "type": "string", "maxLength": 400 },
        "cwd": { "type": "string" }, "updatedAt": { "type": "string" },
        "isPinned": { "type": "boolean" },
        "runtime": { "enum": ["idle", "inProgress", "notLoaded", "unknown"] },
        "historyComplete": { "type": "boolean" },
        "recentComplete": { "type": "boolean" },
        "permissions": { "type": "object", "additionalProperties": false, "required": ["sandbox", "approval"], "properties": { "sandbox": { "enum": ["read_only", "workspace_write", "full_access", "unknown"] }, "approval": { "enum": ["on_request", "never", "unknown"] } } },
        "pendingInteractions": { "type": "array", "items": { "$ref": "#/$defs/interaction" } },
        "queuedMessages": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/queuedMessage" } }
      }
    },
    "turnPatch": {
      "type": "object", "additionalProperties": false,
      "required": ["turnId", "status", "itemOrder", "upsertItems", "removedItemIds"],
      "properties": {
        "turnId": { "$ref": "#/$defs/id" },
        "status": { "enum": ["inProgress", "completed", "failed", "interrupted"] },
        "itemsComplete": { "type": "boolean" },
        "nextItemCursor": { "type": "string" },
        "itemOrder": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "upsertItems": { "type": "array", "items": { "$ref": "#/$defs/item" } },
        "removedItemIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "threadPatch": {
      "type": "object", "additionalProperties": false,
      "required": ["threadState", "turnOrder", "turnPatches", "removedTurnIds"],
      "properties": {
        "threadState": { "$ref": "#/$defs/threadState" },
        "turnOrder": { "type": "array", "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "turnPatches": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/turnPatch" } },
        "removedTurnIds": { "type": "array", "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "queuedMessage": {
      "type": "object", "additionalProperties": false,
      "required": ["queueId", "clientMessageId", "text", "images", "editable"],
      "properties": {
        "queueId": { "$ref": "#/$defs/id" }, "clientMessageId": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "maxLength": 65536 },
        "images": { "type": "array", "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 5592435 } },
        "editable": { "type": "boolean" }
      }
    },
    "turn": {
      "type": "object", "additionalProperties": false,
      "required": ["turnId", "status", "items"],
      "properties": {
        "turnId": { "$ref": "#/$defs/id" },
        "status": { "enum": ["inProgress", "completed", "failed", "interrupted"] },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
        "itemsComplete": { "type": "boolean" },
        "nextItemCursor": { "type": "string" }
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["itemId", "role", "text"],
      "allOf": [{ "if": { "required": ["clientMessageId"] }, "then": { "properties": { "role": { "const": "user" } } } }],
      "properties": {
        "itemId": { "$ref": "#/$defs/id" }, "role": { "enum": ["user", "assistant", "system"] },
        "clientMessageId": { "$ref": "#/$defs/requestId" },
        "text": { "type": "string" },
        "images": { "type": "array", "maxItems": 24, "items": { "type": "object", "additionalProperties": false, "required": ["index", "kind", "alt", "source"], "properties": { "index": { "type": "integer", "minimum": 0 }, "kind": { "enum": ["native", "markdown"] }, "alt": { "type": "string", "maxLength": 256 }, "source": { "type": "string", "maxLength": 2048 } } } },
        "activity": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "label", "status", "detailState", "truncated"],
          "properties": {
            "kind": { "enum": ["mcpToolCall", "commandExecution", "fileChange", "sleep", "imageView", "collabAgentToolCall", "subAgentActivity", "webSearch", "tool"] },
            "label": { "type": "string", "minLength": 1, "maxLength": 512 },
            "status": { "enum": ["inProgress", "completed", "failed", "interrupted", "unknown"] },
            "detailState": { "enum": ["omitted", "available", "loading", "unavailable"] },
            "detailRevision": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "truncated": { "type": "boolean" }
          }
        }
      }
    },
    "interaction": {
      "type": "object", "additionalProperties": false,
      "required": ["interactionId", "kind", "prompt", "availableDecisions"],
      "properties": {
        "interactionId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["command_approval", "file_approval", "permission_request", "user_input", "unsupported"] },
        "prompt": { "type": "string" },
        "availableDecisions": { "type": "array", "uniqueItems": true, "items": { "enum": ["deny", "deny_and_stop", "accept_once", "answer"] } },
        "questions": {
          "type": "array", "minItems": 1, "maxItems": 3,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "question"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "header": { "type": "string", "minLength": 1, "maxLength": 128 },
              "question": { "type": "string", "minLength": 1, "maxLength": 2048 },
              "options": {
                "type": "array", "maxItems": 32,
                "items": {
                  "oneOf": [
                    { "type": "string", "minLength": 1, "maxLength": 512 },
                    {
                      "type": "object", "additionalProperties": false, "required": ["label"],
                      "properties": {
                        "label": { "type": "string", "minLength": 1, "maxLength": 512 },
                        "description": { "type": "string", "maxLength": 2048 }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "deviceStatus": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "v", "event", "deviceId", "agentOnline", "codexReady"],
      "properties": {
        "type": { "const": "event" }, "v": { "const": 1 }, "event": { "const": "device.status" },
        "deviceId": { "$ref": "#/$defs/id" },
        "agentEpoch": { "$ref": "#/$defs/id" },
        "taskStoreId": { "$ref": "#/$defs/id" },
        "agentOnline": { "type": "boolean" }, "codexReady": { "type": "boolean" },
        "capabilities": { "$ref": "#/$defs/capabilities" }
      }
    },
    "threadSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "v", "event", "deviceId", "threadId", "subscriptionId", "streamId", "seq", "thread"],
      "properties": {
        "type": { "const": "event" }, "v": { "const": 1 }, "event": { "const": "thread.snapshot" },
        "deviceId": { "$ref": "#/$defs/id" }, "threadId": { "$ref": "#/$defs/id" },
        "subscriptionId": { "$ref": "#/$defs/id" }, "streamId": { "$ref": "#/$defs/id" },
        "seq": { "const": 1 }, "thread": { "$ref": "#/$defs/thread" }
      }
    },
    "threadUpdate": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "v", "event", "deviceId", "threadId", "subscriptionId", "streamId", "baseSeq", "seq"],
      "properties": {
        "type": { "const": "event" }, "v": { "const": 1 }, "event": { "const": "thread.update" },
        "deviceId": { "$ref": "#/$defs/id" }, "threadId": { "$ref": "#/$defs/id" },
        "subscriptionId": { "$ref": "#/$defs/id" }, "streamId": { "$ref": "#/$defs/id" },
        "baseSeq": { "type": "integer", "minimum": 1 },
        "seq": { "type": "integer", "minimum": 2 },
        "thread": { "$ref": "#/$defs/thread" },
        "patch": { "$ref": "#/$defs/threadPatch" }
      },
      "oneOf": [
        { "required": ["thread"], "not": { "required": ["patch"] } },
        { "required": ["patch"], "not": { "required": ["thread"] } }
      ]
    },
    "threadError": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "v", "event", "deviceId", "threadId", "subscriptionId", "streamId", "code"],
      "properties": {
        "type": { "const": "event" }, "v": { "const": 1 }, "event": { "const": "thread.error" },
        "deviceId": { "$ref": "#/$defs/id" }, "threadId": { "$ref": "#/$defs/id" },
        "subscriptionId": { "$ref": "#/$defs/id" }, "streamId": { "$ref": "#/$defs/id" },
        "code": { "enum": ["HISTORY_TOO_LARGE", "RESYNC_REQUIRED", "NATIVE_STATE_UNCERTAIN"] }
      }
    },
    "threadCacheSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "v", "event", "deviceId", "threadId", "agentEpoch", "cacheStreamId", "seq", "capturedAt", "payloadBytes", "thread"],
      "properties": {
        "type": { "const": "event" }, "v": { "const": 1 }, "event": { "const": "thread.cache.snapshot" },
        "deviceId": { "$ref": "#/$defs/id" }, "threadId": { "$ref": "#/$defs/id" }, "agentEpoch": { "$ref": "#/$defs/id" },
        "cacheStreamId": { "$ref": "#/$defs/id" }, "seq": { "type": "integer", "minimum": 1 },
        "capturedAt": { "type": "string", "minLength": 1, "maxLength": 64 }, "payloadBytes": { "type": "integer", "minimum": 1, "maximum": 8388608 },
        "thread": { "$ref": "#/$defs/thread" }, "asyncQuestions": {}
      }
    },
    "threadCacheUpdate": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "v", "event", "deviceId", "threadId", "watchId", "freshness", "agentOnline"],
      "properties": {
        "type": { "const": "event" }, "v": { "const": 1 }, "event": { "const": "thread.cache.update" },
        "deviceId": { "$ref": "#/$defs/id" }, "threadId": { "$ref": "#/$defs/id" }, "watchId": { "$ref": "#/$defs/id" },
        "freshness": { "enum": ["fresh", "stale", "missing"] }, "staleReason": { "type": "string", "maxLength": 128 },
        "agentOnline": { "type": "boolean" }, "agentEpoch": { "$ref": "#/$defs/id" }, "cacheStreamId": { "$ref": "#/$defs/id" },
        "seq": { "type": "integer", "minimum": 1 }, "capturedAt": { "type": "string", "minLength": 1, "maxLength": 64 },
        "thread": { "$ref": "#/$defs/thread" }, "asyncQuestions": {}
      }
    },
    "threadCacheStatus": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "v", "event", "deviceId", "threadId", "agentEpoch", "cacheStreamId", "freshness"],
      "properties": {
        "type": { "const": "event" }, "v": { "const": 1 }, "event": { "const": "thread.cache.status" },
        "deviceId": { "$ref": "#/$defs/id" }, "threadId": { "$ref": "#/$defs/id" }, "agentEpoch": { "$ref": "#/$defs/id" },
        "cacheStreamId": { "$ref": "#/$defs/id" }, "freshness": { "enum": ["fresh", "stale", "error"] }, "reason": { "type": "string", "maxLength": 128 }
      }
    },
    "threadCacheRemove": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "v", "event", "deviceId", "threadId", "agentEpoch"],
      "properties": {
        "type": { "const": "event" }, "v": { "const": 1 }, "event": { "const": "thread.cache.remove" },
        "deviceId": { "$ref": "#/$defs/id" }, "threadId": { "$ref": "#/$defs/id" }, "agentEpoch": { "$ref": "#/$defs/id" }
      }
    },
    "interactionResolved": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "v", "event", "deviceId", "threadId", "interactionId"],
      "properties": {
        "type": { "const": "event" }, "v": { "const": 1 }, "event": { "const": "interaction.resolved" },
        "deviceId": { "$ref": "#/$defs/id" }, "threadId": { "$ref": "#/$defs/id" },
        "interactionId": { "$ref": "#/$defs/id" }
      }
    },
    "authPairConsumed": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "v", "event"],
      "properties": {
        "type": { "const": "event" }, "v": { "const": 1 }, "event": { "const": "auth.pair.consumed" }
      }
    }
  }
}
