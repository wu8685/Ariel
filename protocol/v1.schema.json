{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wu8685/Ariel/protocol/v1.schema.json",
  "title": "Ariel protocol v1 envelope",
  "oneOf": [
    { "$ref": "#/$defs/webHello" },
    { "$ref": "#/$defs/agentHello" },
    { "$ref": "#/$defs/helloOK" },
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/deviceStatus" },
    { "$ref": "#/$defs/threadSnapshot" },
    { "$ref": "#/$defs/threadUpdate" },
    { "$ref": "#/$defs/threadError" },
    { "$ref": "#/$defs/interactionResolved" },
    { "$ref": "#/$defs/authPairConsumed" }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "requestId": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["autoLoad", "codexReady"],
      "properties": {
        "autoLoad": { "type": "boolean" },
        "codexReady": { "type": "boolean" },
        "history": { "type": "boolean" },
        "send": { "type": "boolean" },
        "interrupt": { "type": "boolean" },
        "interaction": { "type": "boolean" },
        "queue": { "type": "boolean" }
      }
    },
    "webHello": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "v", "role", "token"],
      "properties": {
        "type": { "const": "hello" }, "v": { "const": 1 }, "role": { "const": "web" },
        "token": { "type": "string", "minLength": 1 }
      }
    },
    "agentHello": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "v", "role", "token", "deviceId", "deviceName", "agentEpoch", "adapterVersion", "capabilities"],
      "properties": {
        "type": { "const": "hello" }, "v": { "const": 1 }, "role": { "const": "agent" },
        "token": { "type": "string", "minLength": 1 },
        "deviceId": { "$ref": "#/$defs/id" }, "deviceName": { "$ref": "#/$defs/id" },
        "agentEpoch": { "$ref": "#/$defs/id" }, "adapterVersion": { "$ref": "#/$defs/id" },
        "capabilities": { "$ref": "#/$defs/capabilities" }
      }
    },
    "helloOK": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "v", "connectionId", "relayEpoch"],
      "properties": {
        "type": { "const": "hello.ok" }, "v": { "const": 1 },
        "connectionId": { "$ref": "#/$defs/id" }, "relayEpoch": { "$ref": "#/$defs/id" },
        "sessionToken": { "type": "string", "pattern": "^s_[0-9a-f]{64}$" }
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "v", "requestId", "deviceId", "method", "params"],
      "properties": {
        "type": { "const": "request" }, "v": { "const": 1 },
        "requestId": { "$ref": "#/$defs/requestId" }, "deviceId": { "$ref": "#/$defs/id" },
        "method": { "enum": ["auth.pair.create", "auth.pair.cancel", "device.list", "thread.list", "thread.read", "thread.history", "thread.history.items", "thread.image", "thread.subscribe", "thread.unsubscribe", "turn.start", "turn.interrupt", "queue.add", "queue.update", "queue.delete", "queue.reorder", "queue.steer", "interaction.respond"] },
        "params": { "type": "object" }
      },
      "allOf": [
        { "if": { "properties": { "method": { "const": "auth.pair.create" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/emptyParams" } } } },
        { "if": { "properties": { "method": { "const": "auth.pair.cancel" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/pairCancelParams" } } } },
        { "if": { "properties": { "method": { "const": "device.list" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/emptyParams" } } } },
        { "if": { "properties": { "method": { "const": "thread.list" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/listParams" } } } },
        { "if": { "properties": { "method": { "const": "thread.read" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/threadParams" } } } },
        { "if": { "properties": { "method": { "const": "thread.history" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/historyParams" } } } },
        { "if": { "properties": { "method": { "const": "thread.history.items" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/historyItemsParams" } } } },
        { "if": { "properties": { "method": { "const": "thread.image" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/imageParams" } } } },
        { "if": { "properties": { "method": { "const": "thread.subscribe" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/threadParams" } } } },
        { "if": { "properties": { "method": { "const": "thread.unsubscribe" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/unsubscribeParams" } } } },
        { "if": { "properties": { "method": { "const": "turn.start" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/startParams" } } } },
        { "if": { "properties": { "method": { "const": "turn.interrupt" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/interruptParams" } } } },
        { "if": { "properties": { "method": { "const": "queue.add" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/queueAddParams" } } } },
        { "if": { "properties": { "method": { "const": "queue.update" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/queueUpdateParams" } } } },
        { "if": { "properties": { "method": { "const": "queue.delete" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/queueItemParams" } } } },
        { "if": { "properties": { "method": { "const": "queue.reorder" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/queueReorderParams" } } } },
        { "if": { "properties": { "method": { "const": "queue.steer" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/queueSteerParams" } } } },
        { "if": { "properties": { "method": { "const": "interaction.respond" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/respondParams" } } } }
      ]
    },
    "emptyParams": { "type": "object", "additionalProperties": false },
    "pairCancelParams": {
      "type": "object", "additionalProperties": false, "required": ["credential"],
      "properties": { "credential": { "type": "string", "pattern": "^p_[0-9a-f]{64}$" } }
    },
    "listParams": {
      "type": "object", "additionalProperties": false,
      "properties": { "cursor": { "type": ["string", "null"] }, "limit": { "type": "integer", "minimum": 1, "maximum": 100 }, "searchTerm": { "type": "string", "minLength": 1, "maxLength": 128 } }
    },
    "threadParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId"],
      "properties": { "threadId": { "$ref": "#/$defs/id" } }
    },
    "historyParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId"],
      "properties": { "threadId": { "$ref": "#/$defs/id" }, "cursor": { "type": ["string", "null"] }, "limit": { "type": "integer", "minimum": 1, "maximum": 10 } }
    },
    "historyItemsParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId", "turnId"],
      "properties": { "threadId": { "$ref": "#/$defs/id" }, "turnId": { "$ref": "#/$defs/id" }, "cursor": { "type": ["string", "null"] }, "limit": { "type": "integer", "minimum": 1, "maximum": 100 } }
    },
    "imageParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId", "turnId", "itemId", "imageIndex"],
      "properties": { "threadId": { "$ref": "#/$defs/id" }, "turnId": { "$ref": "#/$defs/id" }, "itemId": { "$ref": "#/$defs/id" }, "imageIndex": { "type": "integer", "minimum": 0, "maximum": 23 } }
    },
    "unsubscribeParams": {
      "type": "object", "additionalProperties": false, "required": ["subscriptionId"],
      "properties": { "subscriptionId": { "$ref": "#/$defs/id" } }
    },
    "startParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId", "clientMessageId", "text"],
      "anyOf": [{ "properties": { "text": { "type": "string", "minLength": 1 } } }, { "required": ["images"], "properties": { "images": { "type": "array", "minItems": 1 } } }],
      "properties": {
        "threadId": { "$ref": "#/$defs/id" }, "clientMessageId": { "$ref": "#/$defs/requestId" },
        "text": { "type": "string", "maxLength": 65536 },
        "images": { "type": "array", "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 5592435 } }
      }
    },
    "interruptParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId", "expectedTurnId"],
      "properties": { "threadId": { "$ref": "#/$defs/id" }, "expectedTurnId": { "$ref": "#/$defs/id" } }
    },
    "queueAddParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId", "clientMessageId", "text"],
      "anyOf": [{ "properties": { "text": { "type": "string", "minLength": 1 } } }, { "required": ["images"], "properties": { "images": { "type": "array", "minItems": 1 } } }],
      "properties": {
        "threadId": { "$ref": "#/$defs/id" }, "clientMessageId": { "$ref": "#/$defs/requestId" },
        "text": { "type": "string", "maxLength": 65536 },
        "images": { "type": "array", "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 5592435 } }
      }
    },
    "queueUpdateParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId", "queueId", "text"],
      "anyOf": [{ "properties": { "text": { "type": "string", "minLength": 1 } } }, { "required": ["images"], "properties": { "images": { "type": "array", "minItems": 1 } } }],
      "properties": {
        "threadId": { "$ref": "#/$defs/id" }, "queueId": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "maxLength": 65536 },
        "images": { "type": "array", "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 5592435 } }
      }
    },
    "queueItemParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId", "queueId"],
      "properties": { "threadId": { "$ref": "#/$defs/id" }, "queueId": { "$ref": "#/$defs/id" } }
    },
    "queueReorderParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId", "queueIds"],
      "properties": { "threadId": { "$ref": "#/$defs/id" }, "queueIds": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } }
    },
    "queueSteerParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId", "queueId", "expectedTurnId"],
      "properties": { "threadId": { "$ref": "#/$defs/id" }, "queueId": { "$ref": "#/$defs/id" }, "expectedTurnId": { "$ref": "#/$defs/id" } }
    },
    "respondParams": {
      "type": "object", "additionalProperties": false, "required": ["threadId", "interactionId", "decision"],
      "properties": {
        "threadId": { "$ref": "#/$defs/id" }, "interactionId": { "$ref": "#/$defs/id" },
        "decision": { "enum": ["deny", "deny_and_stop", "accept_once", "answer"] },
        "answers": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" }, "minItems": 1 } }
      }
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "v", "requestId", "outcome"],
      "properties": {
        "type": { "const": "response" }, "v": { "const": 1 },
        "requestId": { "$ref": "#/$defs/requestId" },
        "outcome": { "enum": ["accepted", "rejected", "unknown", "not_submitted"] },
        "data": { "type": "object" },
        "error": { "$ref": "#/$defs/error" }
      },
      "allOf": [
        { "if": { "properties": { "outcome": { "const": "accepted" } } }, "then": { "required": ["data"], "not": { "required": ["error"] } } },
        { "if": { "properties": { "outcome": { "enum": ["rejected", "unknown", "not_submitted"] } } }, "then": { "required": ["error"] } }
      ]
    },
    "error": {
      "type": "object", "additionalProperties": false, "required": ["code", "message"],
      "properties": {
        "code": { "enum": ["UNAUTHORIZED", "PROTOCOL_UNSUPPORTED", "DEVICE_OFFLINE", "TURN_BUSY", "STALE_TURN", "STALE_INTERACTION", "INTERACTION_UNSUPPORTED", "OUTCOME_UNKNOWN", "RESYNC_REQUIRED", "NATIVE_STATE_UNCERTAIN", "HISTORY_TOO_LARGE", "INVALID_ARGUMENT", "OVERLOADED", "DUPLICATE_AGENT", "NOT_FOUND", "TIMEOUT"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "thread": {
      "type": "object", "additionalProperties": false,
      "required": ["threadId", "title", "cwd", "updatedAt", "runtime", "turns", "pendingInteractions"],
      "properties": {
        "threadId": { "$ref": "#/$defs/id" }, "title": { "type": "string" }, "searchSnippet": { "type": "string", "maxLength": 400 },
        "cwd": { "type": "string" }, "updatedAt": { "type": "string" },
        "runtime": { "enum": ["idle", "inProgress", "notLoaded", "unknown"] },
        "historyComplete": { "type": "boolean" },
        "recentComplete": { "type": "boolean" },
        "permissions": { "type": "object", "additionalProperties": false, "required": ["sandbox", "approval"], "properties": { "sandbox": { "enum": ["read_only", "workspace_write", "full_access", "unknown"] }, "approval": { "enum": ["on_request", "never", "unknown"] } } },
        "turns": { "type": "array", "items": { "$ref": "#/$defs/turn" } },
        "pendingInteractions": { "type": "array", "items": { "$ref": "#/$defs/interaction" } },
        "queuedMessages": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/queuedMessage" } }
      }
    },
    "queuedMessage": {
      "type": "object", "additionalProperties": false,
      "required": ["queueId", "clientMessageId", "text", "images", "editable"],
      "properties": {
        "queueId": { "$ref": "#/$defs/id" }, "clientMessageId": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "maxLength": 65536 },
        "images": { "type": "array", "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 5592435 } },
        "editable": { "type": "boolean" }
      }
    },
    "turn": {
      "type": "object", "additionalProperties": false,
      "required": ["turnId", "status", "items"],
      "properties": {
        "turnId": { "$ref": "#/$defs/id" },
        "status": { "enum": ["inProgress", "completed", "failed", "interrupted"] },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
        "itemsComplete": { "type": "boolean" },
        "nextItemCursor": { "type": "string" }
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["itemId", "role", "text"],
      "properties": {
        "itemId": { "$ref": "#/$defs/id" }, "role": { "enum": ["user", "assistant", "system"] },
        "text": { "type": "string" },
        "images": { "type": "array", "maxItems": 24, "items": { "type": "object", "additionalProperties": false, "required": ["index", "kind", "alt", "source"], "properties": { "index": { "type": "integer", "minimum": 0 }, "kind": { "enum": ["native", "markdown"] }, "alt": { "type": "string", "maxLength": 256 }, "source": { "type": "string", "maxLength": 2048 } } } },
        "activity": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "label", "status", "details", "truncated"],
          "properties": {
            "kind": { "enum": ["mcpToolCall", "commandExecution", "fileChange", "sleep", "imageView"] },
            "label": { "type": "string", "minLength": 1, "maxLength": 512 },
            "status": { "enum": ["inProgress", "completed", "failed", "interrupted", "unknown"] },
            "details": { "type": "string", "maxLength": 16384 },
            "truncated": { "type": "boolean" }
          }
        }
      }
    },
    "interaction": {
      "type": "object", "additionalProperties": false,
      "required": ["interactionId", "kind", "prompt", "availableDecisions"],
      "properties": {
        "interactionId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["command_approval", "file_approval", "permission_request", "user_input", "unsupported"] },
        "prompt": { "type": "string" },
        "availableDecisions": { "type": "array", "uniqueItems": true, "items": { "enum": ["deny", "deny_and_stop", "accept_once", "answer"] } },
        "questions": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "question"], "properties": { "id": { "$ref": "#/$defs/id" }, "question": { "type": "string" }, "options": { "type": "array", "items": { "type": "string" } } } } }
      }
    },
    "deviceStatus": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "v", "event", "deviceId", "agentOnline", "codexReady"],
      "properties": {
        "type": { "const": "event" }, "v": { "const": 1 }, "event": { "const": "device.status" },
        "deviceId": { "$ref": "#/$defs/id" },
        "agentOnline": { "type": "boolean" }, "codexReady": { "type": "boolean" },
        "capabilities": { "$ref": "#/$defs/capabilities" }
      }
    },
    "threadSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "v", "event", "deviceId", "threadId", "subscriptionId", "streamId", "seq", "thread"],
      "properties": {
        "type": { "const": "event" }, "v": { "const": 1 }, "event": { "const": "thread.snapshot" },
        "deviceId": { "$ref": "#/$defs/id" }, "threadId": { "$ref": "#/$defs/id" },
        "subscriptionId": { "$ref": "#/$defs/id" }, "streamId": { "$ref": "#/$defs/id" },
        "seq": { "const": 1 }, "thread": { "$ref": "#/$defs/thread" }
      }
    },
    "threadUpdate": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "v", "event", "deviceId", "threadId", "subscriptionId", "streamId", "baseSeq", "seq", "thread"],
      "properties": {
        "type": { "const": "event" }, "v": { "const": 1 }, "event": { "const": "thread.update" },
        "deviceId": { "$ref": "#/$defs/id" }, "threadId": { "$ref": "#/$defs/id" },
        "subscriptionId": { "$ref": "#/$defs/id" }, "streamId": { "$ref": "#/$defs/id" },
        "baseSeq": { "type": "integer", "minimum": 1 },
        "seq": { "type": "integer", "minimum": 2 },
        "thread": { "$ref": "#/$defs/thread" }
      }
    },
    "threadError": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "v", "event", "deviceId", "threadId", "subscriptionId", "streamId", "code"],
      "properties": {
        "type": { "const": "event" }, "v": { "const": 1 }, "event": { "const": "thread.error" },
        "deviceId": { "$ref": "#/$defs/id" }, "threadId": { "$ref": "#/$defs/id" },
        "subscriptionId": { "$ref": "#/$defs/id" }, "streamId": { "$ref": "#/$defs/id" },
        "code": { "enum": ["HISTORY_TOO_LARGE", "RESYNC_REQUIRED", "NATIVE_STATE_UNCERTAIN"] }
      }
    },
    "interactionResolved": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "v", "event", "deviceId", "threadId", "interactionId"],
      "properties": {
        "type": { "const": "event" }, "v": { "const": 1 }, "event": { "const": "interaction.resolved" },
        "deviceId": { "$ref": "#/$defs/id" }, "threadId": { "$ref": "#/$defs/id" },
        "interactionId": { "$ref": "#/$defs/id" }
      }
    },
    "authPairConsumed": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "v", "event"],
      "properties": {
        "type": { "const": "event" }, "v": { "const": 1 }, "event": { "const": "auth.pair.consumed" }
      }
    }
  }
}
